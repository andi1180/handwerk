NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only — KI-Captions (Haiku 4.5). NIE als NEXT_PUBLIC, nie im Client.
ANTHROPIC_API_KEY=
# Server-only — transaktionale E-Mail (Resend, Schritt 9c-1). NIE als NEXT_PUBLIC.
RESEND_API_KEY=
# Server-only — SMS-Versand über BulkSMS (Feature 3a, Fallback ohne E-Mail). HTTP
# Basic Auth = Token-ID:Token-Secret. NIE als NEXT_PUBLIC, nie im Client.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# Öffentliche Basis-URL der Booklets für den E-Mail-Link (z. B. https://b.valooro.com).
# Ohne Wert wird der Origin des Requests verwendet (dev).
BOOKLET_BASE_URL=
# Server-only — Salt für den IP-Hash der Booklet-Analytics (Schritt 10a). NIE als
# NEXT_PUBLIC. Ohne Wert wird ein leerer Salt verwendet (Hash bleibt deterministisch).
IP_HASH_SALT=
# Server-only — roapp-API-Key für den Inbound-Webhook-Connector (§12). NIE als
# NEXT_PUBLIC, nie im Client. Wird für den Anreicherungs-Call GET /orders/{id} genutzt.
ROAPP_API_KEY=
# Optional — roapp-Statusname, der „abgeholt"/Auslieferung bedeutet (§12). Default
# "Abgeholt". Nur setzen, wenn der Betrieb den Status anders benannt hat.
ROAPP_PICKED_UP_STATUS_NAME=
# Optional — ID des roapp-Custom-Fields mit dem Beschreibungstext der Arbeit (§12).
# Pro Betrieb verschieden. Default "f842212" (Atelier Dax).
ROAPP_DESCRIPTION_FIELD_ID=
